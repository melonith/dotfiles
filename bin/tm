#!/usr/bin/sh

if [ -n "$TMUX" ] ; then
  if [ "$(tmux display-message -p '#S')" = main ] ; then
    return
  fi
  if tmux has-session -t main; then
    tmux switch-client -t main
  fi
fi

tmux_running="$(pgrep tmux)"
if [ -n "$tmux_running" ] ; then
  if ! tmux has-session -t main ; then
    tmux new-session -ds main -c "$HOME"
  fi
  tmux attach -t main
else
	tmux new-session -ds main -c "$HOME"
	tmux attach -t main
fi
